@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/> .

ex:planning a owl:Ontology ;
    owl:versionInfo "1.1" ;
    dcterms:title "Planning ontology" ;
    owl:imports <https://example.org/dependency> .

ex:Plan a owl:Class ;
    rdfs:label "Plan" ;
    rdfs:comment "A plan of work and its milestones." .

ex:Milestone a owl:Class ;
    rdfs:label "Milestone" .

ex:hasStep a owl:ObjectProperty ;
    rdfs:label "has step" ;
    rdfs:domain ex:Plan .

ex:hasMilestone a owl:ObjectProperty ;
    rdfs:label "has milestone" .
